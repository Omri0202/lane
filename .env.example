# L.A.N.E. reads keys from the OS keyring first (`lane keys set ...`).
# These env vars are a fallback for servers / CI where no keyring exists.
# Set only the providers you actually have. LANE routes among whatever it finds.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: bind address for `lane serve`
LANE_HOST=127.0.0.1
LANE_PORT=8080
