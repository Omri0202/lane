{
  "manifest_version": 3,
  "name": "L.A.N.E. — model advisor",
  "version": "0.1.0",
  "description": "Reads what you are typing and tells you which model to pick, before you send it.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["advisor.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {}
}
