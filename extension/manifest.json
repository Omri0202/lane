{
  "manifest_version": 3,
  "name": "L.A.N.E. \u2014 model advisor",
  "version": "0.1.0",
  "description": "Reads what you are typing and tells you which model to pick, before you send it. Works entirely offline.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "core/lane-core.js",
        "profile.js",
        "advisor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/*",
        "https://www.google.co.uk/*",
        "https://www.bing.com/*",
        "https://duckduckgo.com/*",
        "https://search.brave.com/*",
        "https://www.ecosia.org/*"
      ],
      "js": [
        "core/lane-core.js",
        "profile.js",
        "search.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {},
  "optional_host_permissions": [
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "L.A.N.E. - what do you want to do?"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "onboarding.html"
}
